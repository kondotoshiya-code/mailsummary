# ローカルで動作確認するとき用のサンプル。
# 実際の値を入れたファイルは .env として保存（.gitignore 済み・コミットされません）。
# 使い方: set -a; source .env; set +a; python src/main.py

# Gmail OAuth2（scripts/get_refresh_token.py で取得）
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Claude API キー（https://console.anthropic.com/ で発行）
ANTHROPIC_API_KEY=
# 任意。既定は claude-haiku-4-5-20251001
ANTHROPIC_MODEL=

# Google Chat の Incoming Webhook URL
GOOGLE_CHAT_WEBHOOK_URL=

# 任意
TIMEZONE=Asia/Tokyo
# 手動で遡り時間を上書きしたいとき（例: 直近24時間 = 24）
LOOKBACK_HOURS=
